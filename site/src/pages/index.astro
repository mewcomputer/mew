---
import landing from "../../../jianghu/mew.html?raw";
import garden from "../../../jianghu/assets/mew-diorama.glb?url";
import sprites from "../../../jianghu/vendor/tactics/a1.png?url";
import spriteNotice from "../../../jianghu/vendor/tactics/NOTICE.md?raw";
import fontNotice from "../../../jianghu/assets/instrument-sans-OFL.txt?raw";
import seal from "../assets/mew-logo.svg?url";
import "../../../jianghu/mew.css";

const title = "mew";
const description = "Mew is an agent harness designed for your work. Choose a model, give it instructions, and decide which tools it can use.";
const socialImage = new URL("/og/mew.jpg", Astro.site);
const notice = `<!--\n${spriteNotice}\n${fontNotice}-->`;
const chrome = landing
    .slice(landing.indexOf("<body>") + "<body>".length, landing.lastIndexOf("</body>"))
    .replace(/<script\b[^>]*>[\s\S]*?<\/script>/g, "")
    .replace('./assets/mew-diorama.glb', garden)
    .replace('./vendor/tactics/a1.png', sprites)
    .replaceAll('https://mew.computer/docs/', '/docs/');
---

<!doctype html>
<html lang="en" data-theme="dark">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={Astro.url.href} />
        <meta property="og:image" content={socialImage.href} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content="Mew’s headline beside the lantern-lit garden." />
        <meta name="twitter:card" content="summary_large_image" />
        <link rel="icon" type="image/svg+xml" href={seal} />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@600&text=%E5%96%B5&display=swap" />
    </head>
    <body>
        <Fragment set:html={notice} />
        <Fragment set:html={chrome} />
        <script>
            import "../../../jianghu/src/garden-main.ts";
        </script>
    </body>
</html>
