---
import Base from "../layouts/Base.astro";
import CapabilitiesSection from "../components/CapabilitiesSection.tsx";
import "../styles/global.css";
---

<Base>
    <main class="mx-auto px-6 py-16 pt-64 max-w-7xl">
        <section id="top" class="mb-28 max-w-3xl">
            <pre
                class="font-mono leading-tight mb-4 mew-reveal"
                aria-hidden="true"
                style="transition-delay: 0ms">{`
 ╱|、
(˚。7
|、˜〵
じしˍ,)ノ`}</pre>

            <p
                class="font-display text-5xl lg:text-7xl mt-1 mb-8 max-w-3xl mew-reveal"
                style="transition-delay: 300ms"
            >
                mew is the coding harness you can take apart.
            </p>
            <p class="text-lg mew-reveal" style="transition-delay: 600ms">
                Give it a task and it does the work. It finds the code, makes
                the change, runs the tests. <br />And every part of it is a
                plugin away from being yours.
            </p>
            <div
                class="mt-8 max-w-2xl mew-reveal"
                style="transition-delay: 900ms"
            >
                <div
                    class="bg-card border border-border rounded-lg overflow-hidden shadow-sm"
                >
                    <div class="flex border-b border-border">
                        <button
                            type="button"
                            data-install-tab="bash"
                            class="install-tab px-4 py-2 text-sm font-mono text-foreground border-b-2 border-primary bg-primary/5"
                        >
                            bash
                        </button>
                        <button
                            type="button"
                            data-install-tab="brew"
                            class="install-tab px-4 py-2 text-sm font-mono text-muted-foreground border-b-2 border-transparent hover:text-foreground transition-colors"
                        >
                            brew
                        </button>
                    </div>
                    <div class="p-4 flex items-center justify-between gap-4">
                        <code
                            data-install-command="bash"
                            class="font-mono text-sm text-foreground break-all"
                            >curl --proto '=https' --tlsv1.2 -sSf https://mew.computer/get.sh | sh</code
                        >
                        <code
                            data-install-command="brew"
                            class="font-mono text-sm text-foreground break-all hidden"
                            >brew tap mewcomputer/mew && brew install mew</code
                        >
                        <button
                            type="button"
                            class="install-copy text-xs font-mono text-muted-foreground hover:text-foreground transition-colors shrink-0"
                            aria-label="Copy command">copy</button
                        >
                    </div>
                </div>
                <p class="text-sm text-muted-foreground mt-3">
                    Or read the <a
                        href="/docs/getting-started/installation/"
                        class="underline hover:text-foreground transition-colors"
                        >installation docs</a
                    >.
                </p>
            </div>
        </section>

        <div>
            <CapabilitiesSection client:visible />
        </div>

        <section id="why" class="md:mt-96 mt-32 max-w-3xl">
            <h2
                class="font-display text-5xl tracking-tight mb-8 mew-reveal"
                style="transition-delay: 0ms"
            >
                Yours to take apart.
            </h2>
            <p
                class="text-lg text-foreground/80 leading-relaxed mew-reveal"
                style="transition-delay: 400ms"
            >
                mew is a tool you install, not a service you subscribe to. It
                doesn't know your name, it doesn't cache your code, and it works
                the same offline as online. Every provider, tool, and prompt is
                a plugin you can replace. Sessions are plain JSONL on your disk,
                readable end to end. MIT licensed and free. The bus factor is
                you.
            </p>
        </section>

        <section id="install" class="md:mt-64 mt-32 max-w-3xl">
            <h2
                class="text-2xl font-semibold tracking-tight mb-8 mew-reveal"
                style="transition-delay: 0ms"
            >
                Get it running.
            </h2>
            <div
                class="bg-card border border-border rounded-lg p-8 font-mono text-sm leading-relaxed shadow-sm relative mew-reveal"
                style="transition-delay: 400ms"
            >
                <div class="text-foreground font-medium">
                    $ curl --proto '=https' --tlsv1.2 -sSf https://mew.computer/get.sh | sh
                </div>
                <div class="text-muted-foreground">
                    $ export MEW_MODEL_PROVIDER="openai"
                </div>
                <div class="text-muted-foreground">
                    $ export MEW_API_KEY="sk-..."
                </div>
                <div class="text-foreground font-medium">
                    $ mew "add a test for the rate limiter"
                </div>
                <button
                    type="button"
                    data-copy="curl --proto '=https' --tlsv1.2 -sSf https://mew.computer/get.sh | sh"
                    class="absolute top-4 right-4 text-xs font-mono text-muted-foreground hover:text-foreground transition-colors"
                    aria-label="Copy install command">copy</button
                >
            </div>
            <p
                class="text-sm text-muted-foreground mt-4 mew-reveal"
                style="transition-delay: 700ms"
            >
                Works with opencode-zen, z-ai, deepseek, anthropic, openai, or
                anything with an HTTP endpoint and a compatible API shape.
            </p>
        </section>
    </main>

    <script>
        const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
                if (entry.isIntersecting) {
                    requestAnimationFrame(() => {
                        requestAnimationFrame(() => {
                            entry.target.classList.add("mew-reveal-in");
                        });
                    });
                    observer.unobserve(entry.target);
                }
            });
        });
        document.querySelectorAll(".mew-reveal").forEach((el) => {
            observer.observe(el);
        });
    </script>
    <script>
        document.querySelectorAll("[data-copy]").forEach((btn) => {
            btn.addEventListener("click", () => {
                const cmd = btn.getAttribute("data-copy") || "";
                navigator.clipboard
                    ?.writeText(cmd)
                    .then(() => {
                        const prev = btn.textContent;
                        btn.textContent = "copied";
                        setTimeout(() => {
                            btn.textContent = prev;
                        }, 1200);
                    })
                    .catch(() => {});
            });
        });
    </script>
    <script>
        (() => {
            const tabs = document.querySelectorAll("[data-install-tab]");
            const commands = document.querySelectorAll("[data-install-command]");
            const copyBtn = document.querySelector(".install-copy");

            function switchTab(name) {
                tabs.forEach((tab) => {
                    const active = tab.getAttribute("data-install-tab") === name;
                    tab.classList.toggle("border-primary", active);
                    tab.classList.toggle("bg-primary/5", active);
                    tab.classList.toggle("text-foreground", active);
                    tab.classList.toggle("border-transparent", !active);
                    tab.classList.toggle("text-muted-foreground", !active);
                });
                commands.forEach((cmd) => {
                    const visible =
                        cmd.getAttribute("data-install-command") === name;
                    cmd.classList.toggle("hidden", !visible);
                });
            }

            tabs.forEach((tab) => {
                tab.addEventListener("click", () => {
                    switchTab(tab.getAttribute("data-install-tab"));
                });
            });

            if (copyBtn) {
                copyBtn.addEventListener("click", () => {
                    const visible = document.querySelector(
                        "[data-install-command]:not(.hidden)"
                    );
                    const text = visible?.textContent?.trim() || "";
                    navigator.clipboard
                        ?.writeText(text)
                        .then(() => {
                            const prev = copyBtn.textContent;
                            copyBtn.textContent = "copied";
                            setTimeout(() => {
                                copyBtn.textContent = prev;
                            }, 1200);
                        })
                        .catch(() => {});
                });
            }
        })();
    </script>
</Base>
