---
import Base from "../layouts/Base.astro";
import CapabilitiesSection from "../components/CapabilitiesSection.tsx";
import "../styles/global.css";
---

<Base>
    <main class="mx-auto px-6 py-16 pt-64 max-w-7xl">
        <section id="top" class="mb-28 max-w-3xl">
            <pre
                class="font-mono leading-tight mb-4 mew-reveal"
                aria-hidden="true"
                style="transition-delay: 0ms">{`
 ╱|、
(˚。7
|、˜〵
じしˍ,)ノ`}</pre>

            <p
                class="font-display text-5xl lg:text-7xl mt-1 mb-8 max-w-3xl mew-reveal"
                style="transition-delay: 300ms"
            >
                mew is the coding harness you can take apart.
            </p>
            <p class="text-lg mew-reveal" style="transition-delay: 600ms">
                Give it a task and it does the work. It finds the code, makes
                the change, runs the tests. <br />And every part of it is a
                plugin away from being yours.
            </p>
            <div
                class="flex flex-wrap gap-4 mt-8 mew-reveal"
                style="transition-delay: 900ms"
            >
                <button
                    type="button"
                    data-copy="curl --proto '=https' --tlsv1.2 -sSf https://mew.computer/get.sh | sh"
                    class="inline-flex items-center justify-center px-5 py-2.5 rounded-lg bg-primary text-primary-foreground font-medium hover:opacity-90 transition-opacity"
                >
                    Install
                </button>
                <a
                    href="/docs/getting-started/installation/"
                    class="inline-flex items-center justify-center px-5 py-2.5 rounded-lg border border-border bg-card text-foreground font-medium hover:bg-accent hover:text-accent-foreground transition-colors"
                >
                    Docs
                </a>
            </div>
        </section>

        <div>
            <CapabilitiesSection client:visible />
        </div>

        <section id="why" class="md:mt-96 mt-32 max-w-3xl">
            <h2
                class="font-display text-5xl tracking-tight mb-8 mew-reveal"
                style="transition-delay: 0ms"
            >
                Yours to take apart.
            </h2>
            <p
                class="text-lg text-foreground/80 leading-relaxed mew-reveal"
                style="transition-delay: 400ms"
            >
                mew is a tool you install, not a service you subscribe to. It
                doesn't know your name, it doesn't cache your code, and it works
                the same offline as online. Every provider, tool, and prompt is
                a plugin you can replace. Sessions are plain JSONL on your disk,
                readable end to end. MIT licensed and free. The bus factor is
                you.
            </p>
        </section>

        <section id="install" class="md:mt-64 mt-32 max-w-3xl">
            <h2
                class="text-2xl font-semibold tracking-tight mb-8 mew-reveal"
                style="transition-delay: 0ms"
            >
                Get it running.
            </h2>
            <div
                class="bg-card border border-border rounded-lg p-8 font-mono text-sm leading-relaxed shadow-sm relative mew-reveal"
                style="transition-delay: 400ms"
            >
                <div class="text-foreground font-medium">
                    $ curl --proto '=https' --tlsv1.2 -sSf https://mew.computer/get.sh | sh
                </div>
                <div class="text-muted-foreground">
                    $ export MEW_MODEL_PROVIDER="openai"
                </div>
                <div class="text-muted-foreground">
                    $ export MEW_API_KEY="sk-..."
                </div>
                <div class="text-foreground font-medium">
                    $ mew "add a test for the rate limiter"
                </div>
                <button
                    type="button"
                    data-copy="curl --proto '=https' --tlsv1.2 -sSf https://mew.computer/get.sh | sh"
                    class="absolute top-4 right-4 text-xs font-mono text-muted-foreground hover:text-foreground transition-colors"
                    aria-label="Copy install command">copy</button
                >
            </div>
            <p
                class="text-sm text-muted-foreground mt-4 mew-reveal"
                style="transition-delay: 700ms"
            >
                Works with opencode-zen, z-ai, deepseek, anthropic, openai, or
                anything with an HTTP endpoint and a compatible API shape.
            </p>
        </section>
    </main>

    <script>
        const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
                if (entry.isIntersecting) {
                    requestAnimationFrame(() => {
                        requestAnimationFrame(() => {
                            entry.target.classList.add("mew-reveal-in");
                        });
                    });
                    observer.unobserve(entry.target);
                }
            });
        });
        document.querySelectorAll(".mew-reveal").forEach((el) => {
            observer.observe(el);
        });
    </script>
    <script>
        document.querySelectorAll("[data-copy]").forEach((btn) => {
            btn.addEventListener("click", () => {
                const cmd = btn.getAttribute("data-copy") || "";
                navigator.clipboard
                    ?.writeText(cmd)
                    .then(() => {
                        const prev = btn.textContent;
                        btn.textContent = "copied";
                        setTimeout(() => {
                            btn.textContent = prev;
                        }, 1200);
                    })
                    .catch(() => {});
            });
        });
    </script>
</Base>
