---
import garden from "../../../jianghu/assets/mew-diorama.glb?url";
import sprites from "../../../jianghu/vendor/tactics/a1.png?url";
import spriteNotice from "../../../jianghu/vendor/tactics/NOTICE.md?raw";
import fontNotice from "../../../jianghu/assets/instrument-sans-OFL.txt?raw";
import desktopPoster from "../assets/garden-poster.webp?url";
import mobilePoster from "../assets/garden-poster-mobile.webp?url";
import seal from "../assets/mew-logo.svg?url";
import InstallPicker from "../components/InstallPicker.astro";
import "../../../jianghu/mew.css";

const title = "mew";
const description = "A local agent you can inspect, modify, and run with any model.";
const socialImage = new URL("/og/mew.jpg", Astro.site);
const notice = `<!--\n${spriteNotice}\n${fontNotice}-->`;
const packedGarden = `/garden.glb.gz?v=${encodeURIComponent(garden)}`;
---

<!doctype html>
<html lang="en" data-theme="dark">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={Astro.url.href} />
        <meta property="og:image" content={socialImage.href} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content="Mew is an agent harness designed for your work. A lantern-lit garden sits to the right." />
        <meta name="twitter:card" content="summary_large_image" />
        <link rel="icon" type="image/svg+xml" href={seal} />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@600&text=%E5%96%B5&display=swap" />
    </head>
    <body>
        <Fragment set:html={notice} />
        <div class="wash left" aria-hidden="true"></div>
        <div class="wash right" aria-hidden="true"></div>
        <div class="stage" data-garden-stage data-sprite-sheet={sprites} data-garden-model-gzip={packedGarden} data-garden-model={garden}>
          <p data-status role="status">Loading the garden…</p>
          <picture data-garden-poster>
            <source media="(max-width: 860px)" srcset={mobilePoster} />
            <img src={desktopPoster} width="1280" height="720" alt="A lantern-lit walled garden at night" fetchpriority="high" />
          </picture>
          <canvas id="stage" hidden aria-label="A model of a walled garden. Drag to turn it."></canvas>
        </div>

        <header class="bar">
          <a class="mew-wordmark" href="#top" aria-label="mew, back to top"><span class="seal" aria-hidden="true">喵</span><span class="name">mew</span></a>
          <nav class="links" aria-label="Links">
            <a href="https://github.com/mewcomputer/mew">GitHub</a>
            <a href="/docs/">Docs</a>
          </nav>
          <a class="mew-button mew-header-button primary" href="#start">Get started</a>
        </header>

        <div class="view" data-controls hidden role="group" aria-label="Garden view">
          <span class="hint">Drag to turn the garden</span>
          <button data-turn="left" type="button" aria-label="Turn the garden left">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.3-5.6"/><path d="M4 4v4h4"/></svg>
          </button>
          <button data-turn="right" type="button" aria-label="Turn the garden right">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12a8 8 0 1 1-2.3-5.6"/><path d="M20 4v4h-4"/></svg>
          </button>
          <button data-tilt aria-pressed="false" type="button" aria-label="Change the viewing angle">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 15l9 5 9-5-9-5z"/><path d="M12 10V4"/><path d="M9.5 6.5L12 4l2.5 2.5"/></svg>
          </button>
          <button data-night aria-pressed="true" type="button" aria-label="Switch to day">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4 7 17M17 7l1.4-1.4M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0z"/></svg>
          </button>
        </div>

        <main data-mew-story>
          <section class="hero" id="top" data-focus="garden">
            <div class="intro">
              <h1>Mew is an agent harness designed for your work.</h1>
              <p class="lede">A local agent you can inspect, modify, and run with any model.</p>
              <div class="ctas">
                <a class="mew-button primary" href="#start">Get started with mew <span aria-hidden="true">→</span></a>
                <a class="mew-button" href="https://github.com/mewcomputer/mew">View on GitHub</a>
              </div>
              <p class="note">mew is experimental and under active development.</p>
            </div>

          </section>

          <section class="room" data-focus="hall" data-side="left">
            <div class="panel">
              <h2>Give it a task, and pick up from any client.</h2>
              <p>Ask mew to explore a project, dig through docs, or make a change. It reads and searches files, checks that files have not changed before writing so outdated edits fail safely, and runs commands when the work calls for it.</p>
              <p>A local background service owns the conversation, tool calls, and session history. Start a turn in the terminal, then attach to the same live session from the browser or desktop app. Follow along, answer questions, or steer a running turn without starting over.</p>
            </div>
          </section>

          <section class="room" data-focus="pavilion" data-side="right">
            <div class="panel">
              <h2>Bring in another agent.</h2>
              <p>Give a subagent a focused task in its own context while the main thread keeps moving. Send a read-only researcher to find every caller of an API you are replacing, ask a reviewer to check a plan, or run several subagents in parallel.</p>
              <p>Each subagent can carry its own instructions, model, tool list, and turn or time limits. Only the final answer returns to your conversation, while the full child transcript stays saved beneath the parent session.</p>
            </div>
          </section>

          <section class="room" data-focus="gallery" data-side="left">
            <div class="panel">
              <h2>Make an agent for the job.</h2>
              <p>Personas let you switch roles without rewriting your setup. Keep one for coding with shell access, one for research restricted to read-only tools, or one with no tools at all for conversation and writing.</p>
              <p>Each persona can pin a model, choose which tools and external integrations it can reach, and adapt its instructions to the active model. For larger changes, start with the built-in planner to draft and review a plan, then switch to the builder to carry it out.</p>
            </div>
          </section>

          <section class="room" data-focus="wall" data-side="right">
            <div class="panel">
              <h2>Decide what needs approval.</h2>
              <p>Every tool call passes through a permission check before it runs. Write rules by tool, command, or path, and keep file access and shell checks scoped to your workspace. Let tests run silently while pushing a branch or reading secret files still stops and asks.</p>
              <p>Switch permission modes per session as the work changes, from strict prompts on every edit to automatic checks routed through a separate review model. Configured secrets are redacted from tool output before reaching the model.</p>
            </div>
          </section>

          <section class="room" data-focus="gate" data-side="left">
            <div class="panel">
              <h2>Pick up where you left off.</h2>
              <p>Keep permanent project instructions on hand, and save repeatable workflows as skills that load only when a task calls for them. A release skill can spell out the exact checks to run before cutting a tag without crowding unrelated turns.</p>
              <p>Every conversation saves locally as plain files alongside its history, todos, and active settings. Search past transcripts on disk, resume any session later, or connect external tools when you need more reach.</p>
            </div>
          </section>

          <section class="room" id="start" data-focus="tower" data-side="left">
            <div class="panel">
              <h2>Try mew in your project.</h2>
              <p>Install the nightly build, connect a supported model provider, and open a session in your working directory.</p>
              <InstallPicker />
              <div class="ctas">
                <a class="mew-button" href="/docs/getting-started/installation/">Read the install guide</a>
              </div>
            </div>
          </section>
        </main>

        <footer>
          <div class="foot">
            <a href="https://github.com/mewcomputer/mew">GitHub</a>
            <a href="/docs/">Docs</a>
            <span>Sprites by <a href="https://3d.internet.dev">3d.internet.dev</a></span>
          </div>
        </footer>

        <div id="character-label" role="status" hidden><span class="name"></span><span class="line"></span></div>
        <script>
            import "../../../jianghu/src/garden-main.ts";
        </script>
    </body>
</html>
