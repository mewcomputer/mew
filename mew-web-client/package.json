{
  "name": "@mew/web-client",
  "version": "0.1.0",
  "description": "TypeScript client for the mew daemon wire protocol (WebSocket). Browser-native; uses the standard WebSocket API.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --experimental-strip-types --test src/__tests__/*.test.ts"
  },
  "dependencies": {
    "ws": "^8.16"
  }
}