#!/usr/bin/env bash
# Pre-commit: fast checks that catch obvious mistakes before a commit lands.
# Runs fmt check, clippy, and arch-check.
set -euo pipefail

# GUI apps (Zed, VS Code, etc.) run hooks with a minimal PATH that
# doesn't include cargo, just, mise, homebrew, etc. Add the common
# locations so the hooks work regardless of how git was invoked.
export PATH="$HOME/.cargo/bin:$HOME/.local/share/mise/shims:$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

echo "🔍 Running cargo fmt --check..."
cargo fmt --check
echo "✅ fmt clean"

echo "🔍 Running clippy..."
cargo clippy --all -- -D warnings 2>&1 | tail -3
echo "✅ clippy clean"

echo "🔍 Running arch-check..."
just arch-check
echo "✅ arch-check passed"

echo "✅ All pre-commit checks passed!"
