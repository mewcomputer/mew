#!/usr/bin/env bash
# Pre-push: full test suite. This is the gate that prevents broken code
# from reaching the remote.
set -euo pipefail

# GUI apps (Zed, VS Code, etc.) run hooks with a minimal PATH that
# doesn't include cargo, just, mise, homebrew, etc. Add the common
# locations so the hooks should? work regardless of how git was invoked.
export PATH="$HOME/.cargo/bin:$HOME/.local/share/mise/shims:$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

echo "🧪 Running full test suite (cargo test --all)..."
cargo test --all 2>&1 | grep -E "test result:|FAILED|error\[" | grep -v "0 passed; 0 failed" || true
echo "✅ tests passed"

echo "🔍 Running theme-codegen-check..."
just theme-codegen-check
echo "✅ theme-codegen clean"

echo "✅ All pre-push checks passed!"
