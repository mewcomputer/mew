#!/usr/bin/env bash
# Pre-push: full test suite. This is the gate that prevents broken code
# from reaching the remote. Slower than pre-commit, but catches regressions.
set -euo pipefail

echo "🧪 Running full test suite (cargo test --all)..."
cargo test --all 2>&1 | grep -E "test result:|FAILED|error\[" | grep -v "0 passed; 0 failed" || true
echo "✅ tests passed"

echo "🔍 Running theme-codegen-check..."
just theme-codegen-check
echo "✅ theme-codegen clean"

echo "✅ All pre-push checks passed!"
