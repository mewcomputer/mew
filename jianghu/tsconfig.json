{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "types": [
      "node",
      "@webgpu/types"
    ]
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "vendor/**/*.d.mts",
    "tools/**/*.ts"
  ]
}
