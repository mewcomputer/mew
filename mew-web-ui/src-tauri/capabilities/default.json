{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for the mew desktop window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/mew",
          "sidecar": true,
          "args": true
        },
        {
          "name": "binaries/mew-cef-host-helper",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ]
}
